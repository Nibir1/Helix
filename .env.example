# .env.example
# Helix environment configuration examples.
# Copy to .env or export manually in your shell.

# Optional: NVD API key.
# Strongly recommended for reliable NVD CVE syncing.
NVD_API_KEY=

# Optional: override NVD start date.
# Format: yyyy-MM-ddTHH:mm:ss.SSSZ
# If empty, Helix uses a safe rolling 120-day window.
NVD_START_DATE=

# Optional: override model storage directory.
# Default: ~/.helix/models
HELIX_MODEL_DIR=

# Optional: enable verbose byte-level debug output.
# Set to 1 to enable.
HELIX_DEBUG=

# ------------------------------------------------------------------
# Provider API keys.
# Helix preferentially uses its encrypted-permission keystore at
# ~/.helix/secrets.json, but environment variables are honored too.
# ------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
QWEN_API_KEY=
GLM_API_KEY=
CUSTOM_API_KEY=