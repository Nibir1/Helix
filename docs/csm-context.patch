+            context,
             audio_tx,
         );
@@ response construction
-    Body::from_stream(ReceiverStream::new(rx))
+    // Advertise what was actually conditioned on. Serde ignores unknown fields
+    // by default, so an unpatched server accepts `context` and silently drops
+    // it; without this header a client cannot distinguish a conditioned reply
+    // from an unconditioned one.
+    let mut response = Response::new(Body::from_stream(ReceiverStream::new(rx)));
+    response.headers_mut().insert(
+        "X-CSM-Context-Segments",
+        applied_segments.to_string().parse().unwrap(),
+    );
+    response

