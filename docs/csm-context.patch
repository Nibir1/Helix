 use moshi::mimi;
+
+/// One prior turn of the conversation.
+///
+/// `audio` is 24 kHz mono f32 at the tokenizer's sample rate. `None` is valid:
+/// the model conditions on text as well, and a caller that streamed a turn may
+/// hold its transcript without one contiguous clip.
+#[derive(Clone, Debug, Default)]
+pub struct ContextSegment {
+    pub speaker_id: u32,
+    pub text: String,
+    pub audio: Option<Vec<f32>>,
+}

 impl Generator {
+    /// Encodes raw samples into Mimi frames.
+    ///
+    /// Uses the same codebook count as `decode_frames`, so the frames handed to
+    /// the backbone match the ones it was trained to see coming back out.
+    fn encode_audio(&mut self, samples: &[f32]) -> Result<Vec<Vec<u32>>> {
+        if samples.is_empty() {
+            return Ok(Vec::new());
+        }
+        let n = samples.len();
+        // Mimi expects (batch, channels, samples).
+        let pcm = Tensor::from_vec(samples.to_vec(), (1, 1, n), &self.device)?
+            .to_dtype(self.dtype)?;
+
+        let codes = self.audio_tokenizer.encode(&pcm)?;
+        // codes: (batch, codebooks, frames) -> per-frame Vec<u32>
+        let codes = codes.i(0)?.to_dtype(DType::U32)?;
+        let (num_codebooks, num_frames) = codes.dims2()?;
+
+        let flat: Vec<u32> = codes.transpose(0, 1)?.flatten_all()?.to_vec1()?;
+        let mut frames = Vec::with_capacity(num_frames);
+        for f in 0..num_frames {
+            frames.push(flat[f * num_codebooks..(f + 1) * num_codebooks].to_vec());
+        }
+        Ok(frames)
+    }
+
+    /// Builds the token/mask prefix for prior turns, oldest first.
+    ///
+    /// Returns `(tokens, mask)` shaped like the prompt so the caller can simply
+    /// concatenate along dim 1, or `None` when there is no usable context.
+    fn build_context_prefix(
+        &mut self,
+        context: &[ContextSegment],
+        tokenizer_template: Option<&str>,
+    ) -> Result<Option<(Tensor, Tensor)>> {
+        let mut parts: Vec<(Tensor, Tensor)> = Vec::new();
+
+        for seg in context {
+            if !seg.text.trim().is_empty() {
+                let (t, m) = self.tokenize_text(&seg.text, seg.speaker_id, tokenizer_template)?;
+                parts.push((t, m));
+            }
+            if let Some(samples) = seg.audio.as_ref() {
+                for frame in self.encode_audio(samples)? {
+                    let (t, m) = self.model.audio_tokens_and_mask(frame)?;
+                    parts.push((t, m));
+                }
+            }
+        }
+        if parts.is_empty() {
+            return Ok(None);
+        }
+
+        let tokens: Vec<Tensor> = parts.iter().map(|(t, _)| t.clone()).collect();
+        let masks: Vec<Tensor> = parts.iter().map(|(_, m)| m.clone()).collect();
+        Ok(Some((Tensor::cat(&tokens, 1)?, Tensor::cat(&masks, 1)?)))
+    }
+
+    /// Prepends context to a prompt, trimming the OLDEST tokens if the result
+    /// exceeds the model's window.
+    ///
+    /// Trimming rather than erroring is deliberate: a caller that sends a long
+    /// history should get recent history, not a failed request.
+    fn prepend_context(
+        &mut self,
+        prompt: (Tensor, Tensor),
+        context: &[ContextSegment],
+        tokenizer_template: Option<&str>,
+    ) -> Result<(Tensor, Tensor)> {
+        let (p_tokens, p_mask) = prompt;
+        let prefix = match self.build_context_prefix(context, tokenizer_template)? {
+            Some(p) => p,
+            None => return Ok((p_tokens, p_mask)),
+        };
+
+        let mut tokens = Tensor::cat(&[prefix.0, p_tokens], 1)?;
+        let mut mask = Tensor::cat(&[prefix.1, p_mask], 1)?;
+
+        let seq_len = tokens.dim(1)?;
+        if seq_len > self.max_seq_len {
+            let start = seq_len - self.max_seq_len;
+            tokens = tokens.narrow(1, start, self.max_seq_len)?;
+            mask = mask.narrow(1, start, self.max_seq_len)?;
+            log::info!("context trimmed to the most recent {} tokens", self.max_seq_len);
+        }
+        Ok((tokens, mask))
+    }
+
     pub fn generate_to_channel(
         &mut self,
         text: &str,
         speaker_id: u32,
         max_audio_len_ms: f32,
         temperature: f64,
         top_k: usize,
         buffer_size: usize,
         tokenizer_template: Option<String>,
+        context: Vec<ContextSegment>,
         tx: std_mpsc::SyncSender<Result<Tensor>>,
     ) {
@@ generate_to_channel
-        let (prompt_tokens, prompt_mask) = match self.tokenize_text(text, speaker_id, tokenizer_template.as_deref()) {
-            Ok(t) => t,
-            Err(e) => { let _ = tx.send(Err(e)); return; }
-        };
+        let prompt = match self.tokenize_text(text, speaker_id, tokenizer_template.as_deref()) {
+            Ok(t) => t,
+            Err(e) => { let _ = tx.send(Err(e)); return; }
+        };
+        let (prompt_tokens, prompt_mask) =
+            match self.prepend_context(prompt, &context, tokenizer_template.as_deref()) {
+                Ok(t) => t,
+                Err(e) => { let _ = tx.send(Err(e)); return; }
