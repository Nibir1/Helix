+use base64::Engine as _;
+use csm_core::ContextSegment;
+
+/// One prior turn on the wire.
+///
+/// Mirrors the reference `Segment(text, speaker, audio)` so a client written
+/// against the Python API has an obvious mapping. `audio_b64` is optional.
+#[derive(Deserialize, Debug, Clone)]
+struct ContextSegmentDto {
+    #[serde(default)]
+    speaker: u32,
+    #[serde(default)]
+    text: String,
+    #[serde(default)]
+    audio_b64: Option<String>,
+    /// "wav" (default) or "pcm" — raw little-endian 16-bit mono.
+    #[serde(default)]
+    format: Option<String>,
+}
+
 #[derive(Deserialize, Debug)]
 struct SpeechRequest {
     input: String,
     #[serde(default)]
     speaker_id: u32,
@@
     buffer_size: usize,
-    tokenizer_template: Option<String>
+    tokenizer_template: Option<String>,
+    /// Prior turns, oldest first. Absent means single-utterance synthesis.
+    #[serde(default)]
+    context: Vec<ContextSegmentDto>,
 }
+
+/// Decodes one wire segment into samples at the tokenizer's rate.
+///
+/// WAV is parsed for its data chunk rather than assumed to be 44 bytes of
+/// header: encoders emit LIST/INFO chunks and a fixed offset silently shifts
+/// the audio, which is audible as a click and a wrong start.
+fn decode_segment(dto: &ContextSegmentDto) -> anyhow::Result<ContextSegment> {
+    let mut audio = None;
+    if let Some(b64) = dto.audio_b64.as_ref() {
+        if !b64.is_empty() {
+            let raw = base64::engine::general_purpose::STANDARD.decode(b64)?;
+            let pcm = match dto.format.as_deref().unwrap_or("wav") {
+                "pcm" => raw,
+                _ => wav_data_chunk(&raw)?,
+            };
+            let mut samples = Vec::with_capacity(pcm.len() / 2);
+            for c in pcm.chunks_exact(2) {
+                samples.push(i16::from_le_bytes([c[0], c[1]]) as f32 / 32768.0);
+            }
+            audio = Some(samples);
+        }
+    }
+    Ok(ContextSegment { speaker_id: dto.speaker, text: dto.text.clone(), audio })
+}
+
+/// Returns the bytes of a RIFF/WAVE `data` chunk.
+fn wav_data_chunk(raw: &[u8]) -> anyhow::Result<Vec<u8>> {
+    if raw.len() < 12 || &raw[0..4] != b"RIFF" || &raw[8..12] != b"WAVE" {
+        anyhow::bail!("context audio is not RIFF/WAVE");
+    }
+    let mut i = 12;
+    while i + 8 <= raw.len() {
+        let id = &raw[i..i + 4];
+        let size = u32::from_le_bytes([raw[i + 4], raw[i + 5], raw[i + 6], raw[i + 7]]) as usize;
+        let body = i + 8;
+        if id == b"data" {
+            let end = (body + size).min(raw.len());
+            return Ok(raw[body..end].to_vec());
+        }
+        i = body + size + (size & 1); // chunks are word-aligned
+    }
+    anyhow::bail!("no data chunk in context audio")
+}
@@ speech_handler
+    // Decode context before spawning: a malformed segment should be a 400, not
+    // a failure discovered halfway through a streamed response whose header has
+    // already been sent.
+    let mut context = Vec::with_capacity(payload.context.len());
+    for dto in &payload.context {
+        match decode_segment(dto) {
+            Ok(seg) => context.push(seg),
+            Err(e) => {
+                return (
+                    StatusCode::BAD_REQUEST,
+                    Json(ErrorResponse { error: format!("invalid context segment: {e}") }),
+                ).into_response();
+            }
+        }
+    }
+    let applied_segments = context.len();
+
     let (tx, rx) = mpsc::channel::<Result<Bytes, std::io::Error>>(16);
@@
         generator.generate_to_channel(
             &input,
             speaker_id,
             max_audio_len_ms,
             temperature,
